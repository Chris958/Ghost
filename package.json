{
  "name": "ghost-ticker",
  "version": "1.0.0",
  "description": "A discreet, transparent A-share desktop ticker powered by Tushare.",
  "main": "src/main.cjs",
  "author": "Chris958",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "37.2.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.chris958.ghost",
    "productName": "Ghost",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ghost"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Finance"
    }
  }
}
